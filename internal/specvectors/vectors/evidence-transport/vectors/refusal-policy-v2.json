  "sequences": [
    {
      "name": "422 unknown_key is retried on the next handoff, never on a timer, and accepted once the key is active",
      "steps": [
        {"event": "deliver", "response": {"status": 422, "reason": "unknown_key"}, "expect": "retained"},
        {"event": "timer_elapsed", "expect": "no_attempt"},
        {"event": "handoff", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}}
      ]
    },
    {
      "name": "an unsupported artifact version is retried on the next handoff and accepted after an upgrade",
      "steps": [
        {"event": "deliver", "response": {"status": 422, "reason": "unrecognised_version"}, "expect": "retained"},
        {"event": "timer_elapsed", "expect": "no_attempt"},
        {"event": "restart", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}}
      ]
    },
    {
      "name": "a durable hold stays held across handoffs, timers and restarts",
      "steps": [
        {"event": "deliver", "response": {"status": 422, "reason": "bad_authenticator"}, "expect": "held"},
        {"event": "handoff", "expect": "no_attempt"},
        {"event": "timer_elapsed", "expect": "no_attempt"},
        {"event": "restart", "expect": "no_attempt"}
      ]
    },
    {
      "name": "429 is retried no earlier than Retry-After, across a restart",
      "steps": [
        {"event": "deliver", "response": {"status": 429, "reason": "rate_limited", "retry_after_s": 60}, "expect": "retained"},
        {"event": "handoff", "expect": "no_attempt_before_retry_after"},
        {"event": "timer_elapsed", "expect": "no_attempt_before_retry_after"},
        {"event": "restart", "expect": "no_attempt_before_retry_after"},
        {"event": "retry_after_elapsed", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}}
      ]
    },
    {
      "name": "every retry carries a fresh transport envelope over unchanged artifact bytes",
      "steps": [
        {"event": "deliver", "response": {"status": 401, "reason": "stale"}, "expect": "retained"},
        {"event": "handoff", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}}
      ]
    },
    {
      "name": "a courier restart is a handoff",
      "steps": [
        {"event": "deliver", "response": {"status": 403, "reason": "not_authorized"}, "expect": "retained"},
        {"event": "timer_elapsed", "expect": "no_attempt"},
        {"event": "restart", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}}
      ]
    },
    {
      "name": "a handoff or a restart never brings a back-off forward",
      "steps": [
        {"event": "deliver", "response": {"status": 503, "reason": "unavailable"}, "expect": "retained"},
        {"event": "handoff", "expect": "no_attempt_before_backoff"},
        {"event": "restart", "expect": "no_attempt_before_backoff"},
        {"event": "backoff_elapsed", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}}
      ]
    },
    {
      "name": "an unrecognised outcome backs off and never retires",
      "steps": [
        {"event": "deliver", "response": {"status": 413}, "expect": "retained"},
        {"event": "handoff", "expect": "no_attempt_before_backoff"},
        {"event": "backoff_elapsed", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 413}},
        {"event": "backoff_elapsed", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}}
      ]
    },
    {
      "name": "a registration conflict backs off in its own lane and resolves once commissioning does",
      "steps": [
        {"event": "deliver", "lane": "registration", "response": {"status": 409, "reason": "pending_registration_conflict"}, "expect": "retained"},
        {"event": "deliver", "lane": "evidence", "response": {"status": 200}, "expect": "retired"},
        {"event": "handoff", "lane": "registration", "expect": "no_attempt_before_backoff"},
        {"event": "backoff_elapsed", "lane": "registration", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 409, "reason": "pending_registration_conflict"}},
        {"event": "backoff_elapsed", "lane": "registration", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 422, "reason": "commissioning_digest_mismatch", "outcome": "refused_retained"}, "then": "archived"},
        {"event": "deliver", "lane": "registration", "response": {"status": 200}, "expect": "retired"}
      ]
    },
    {
      "name": "a retired registration is a handoff for the device's evidence lane",
      "steps": [
        {"event": "deliver", "lane": "evidence", "response": {"status": 422, "reason": "unknown_key"}, "expect": "retained"},
        {"event": "deliver", "lane": "registration", "response": {"status": 409, "reason": "pending_registration_conflict"}, "expect": "retained"},
        {"event": "timer_elapsed", "lane": "evidence", "expect": "no_attempt"},
        {"event": "backoff_elapsed", "lane": "registration", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}},
        {"event": "registration_retired", "lane": "evidence", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}}
      ]
    },
    {
      "name": "a new artifact in one lane is a handoff for the device's other lane",
      "steps": [
        {"event": "deliver", "lane": "evidence", "response": {"status": 422, "reason": "unknown_key"}, "expect": "retained"},
        {"event": "timer_elapsed", "lane": "evidence", "expect": "no_attempt"},
        {"event": "artifact_handed_off_in_other_lane", "lane": "evidence", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}}
      ]
    },
    {
      "name": "a terminal registration refusal is archived and never blocks a later registration",
      "steps": [
        {"event": "deliver", "lane": "registration", "response": {"status": 422, "reason": "commissioning_digest_mismatch", "outcome": "refused_retained"}, "expect": "archived"},
        {"event": "deliver", "lane": "registration", "response": {"status": 200}, "expect": "retired"}
      ]
    },
    {
      "name": "a registration refusal answered without retention is held, and a hold not yet durable is sent once more after a restart",
      "steps": [
        {"event": "deliver", "lane": "registration", "response": {"status": 400, "reason": "malformed"}, "hold_persisted": false, "expect": "held"},
        {"event": "restart", "lane": "registration", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 400, "reason": "malformed"}}
      ]
    },
    {
      "name": "an evidence-lane hold stays at the head of its lane",
      "steps": [
        {"event": "deliver", "lane": "evidence", "response": {"status": 409, "reason": "conflict"}, "expect": "held"},
        {"event": "handoff", "lane": "evidence", "expect": "no_attempt"}
      ]
    },
    {
      "name": "a registration accepted pending is re-offered as a new admission only while the runtime holds neither a confirmation nor a disposition",
      "steps": [
        {"event": "deliver", "lane": "registration", "response": {"status": 200}, "expect": "retired"},
        {"event": "deliver", "lane": "registration", "response": {"status": 200}, "expect": "retired"}
      ]
    },
    {
      "name": "one device's hold never delays another device",
      "steps": [
        {"event": "deliver", "device": "device-a", "response": {"status": 409, "reason": "conflict"}, "expect": "held"},
        {"event": "deliver", "device": "device-b", "response": {"status": 200}, "expect": "retired"},
        {"event": "handoff", "device": "device-a", "expect": "no_attempt"}
      ]
    },
    {
      "name": "a hold not yet durable is sent once more per process that starts without it",
      "steps": [
        {"event": "deliver", "response": {"status": 409, "reason": "conflict"}, "hold_persisted": false, "expect": "held"},
        {"event": "handoff", "expect": "no_attempt"},
        {"event": "restart", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 409, "reason": "conflict"}, "hold_persisted": false},
        {"event": "restart", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 409, "reason": "conflict"}},
        {"event": "restart", "expect": "no_attempt"}
      ]
    },
    {
      "name": "a retained checkpoint rollback is archived and the next envelope is delivered",
      "steps": [
        {"event": "deliver", "response": {"status": 200}, "expect": "retired"},
        {"event": "deliver", "response": {"status": 409, "reason": "conflict", "outcome": "refused_retained"}, "expect": "archived"},
        {"event": "deliver", "response": {"status": 200}, "expect": "retired"}
      ]
    },
    {
      "name": "an archive survives a restart and is never re-sent",
      "steps": [
        {"event": "deliver", "response": {"status": 409, "reason": "conflict", "outcome": "refused_retained"}, "expect": "archived"},
        {"event": "restart", "expect": "no_attempt"},
        {"event": "handoff", "expect": "no_attempt"},
        {"event": "timer_elapsed", "expect": "no_attempt"}
      ]
    },
    {
      "name": "an archive that cannot commit leaves the head held, and the identical retry after a restart archives it",
      "steps": [
        {"event": "deliver", "response": {"status": 409, "reason": "conflict", "outcome": "refused_retained"}, "archive_persisted": false, "expect": "held"},
        {"event": "handoff", "expect": "no_attempt"},
        {"event": "timer_elapsed", "expect": "no_attempt"},
        {"event": "restart", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 409, "reason": "conflict", "outcome": "refused_retained"}, "then": "archived"},
        {"event": "restart", "expect": "no_attempt"}
      ]
    },
    {
      "name": "a terminal refusal answered without retention is held in either lane",
      "steps": [
        {"event": "deliver", "lane": "evidence", "response": {"status": 422, "reason": "binding_mismatch"}, "expect": "held"},
        {"event": "deliver", "lane": "registration", "response": {"status": 422, "reason": "commissioning_digest_mismatch"}, "expect": "held"},
        {"event": "restart", "lane": "evidence", "expect": "no_attempt"},
        {"event": "restart", "lane": "registration", "expect": "no_attempt"}
      ]
    },
    {
      "name": "a retention that does not bind never releases the gateway copy, and the verified retry archives it",
      "steps": [
        {"event": "deliver", "response": {"status": 409, "reason": "conflict", "outcome": "refused_retained", "retention": "digest_mismatch"}, "expect": "retained"},
        {"event": "handoff", "expect": "no_attempt_before_backoff"},
        {"event": "backoff_elapsed", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 409, "reason": "conflict", "outcome": "refused_retained", "retention": "device_mismatch"}, "then": "retained"},
        {"event": "backoff_elapsed", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 409, "reason": "conflict", "outcome": "refused_retained", "retention": "bad_mac"}, "then": "retained"},
        {"event": "backoff_elapsed", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 409, "reason": "conflict", "outcome": "refused_retained"}, "then": "archived"}
      ]
    },
    {
      "name": "a 507 holds only that device's lane while its other lane and another device deliver",
      "steps": [
        {"event": "deliver", "device": "device-a", "lane": "evidence", "response": {"status": 507, "reason": "retention_capacity_exhausted"}, "expect": "held"},
        {"event": "deliver", "device": "device-a", "lane": "registration", "response": {"status": 200}, "expect": "retired"},
        {"event": "deliver", "device": "device-b", "lane": "evidence", "response": {"status": 200}, "expect": "retired"},
        {"event": "handoff", "device": "device-a", "lane": "evidence", "expect": "no_attempt"},
        {"event": "restart", "device": "device-a", "lane": "evidence", "expect": "no_attempt"}
      ]
    },
    {
      "name": "non-terminal refusals stay active and are delivered once their condition changes",
      "steps": [
        {"event": "deliver", "device": "device-a", "response": {"status": 422, "reason": "unknown_key"}, "expect": "retained"},
        {"event": "deliver", "device": "device-b", "lane": "registration", "response": {"status": 409, "reason": "pending_registration_conflict"}, "expect": "retained"},
        {"event": "deliver", "device": "device-c", "lane": "registration", "response": {"status": 429, "reason": "pending_registration_limit", "retry_after_s": 300}, "expect": "retained"},
        {"event": "deliver", "device": "device-d", "response": {"status": 503, "reason": "unavailable"}, "expect": "retained"},
        {"event": "handoff", "device": "device-a", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}, "then": "retired"},
        {"event": "backoff_elapsed", "device": "device-b", "lane": "registration", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}, "then": "retired"},
        {"event": "retry_after_elapsed", "device": "device-c", "lane": "registration", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}, "then": "retired"},
        {"event": "backoff_elapsed", "device": "device-d", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}, "then": "retired"}
      ]
    },
    {
      "name": "an authenticated queue_full for a configured device is a handoff for its waiting head",
      "steps": [
        {"event": "deliver", "response": {"status": 422, "reason": "unknown_key"}, "expect": "retained"},
        {"event": "timer_elapsed", "expect": "no_attempt"},
        {"event": "queue_full", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 422, "reason": "unknown_key"}, "then": "retained"},
        {"event": "queue_full", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}, "then": "retired"}
      ]
    },
    {
      "name": "a pending registration's confirmation returns through a queue_full handoff on a minimum share",
      "steps": [
        {"event": "deliver", "lane": "registration", "response": {"status": 200}, "expect": "retired"},
        {"event": "deliver", "lane": "evidence", "response": {"status": 422, "reason": "unknown_key"}, "expect": "retained"},
        {"event": "timer_elapsed", "lane": "evidence", "expect": "no_attempt"},
        {"event": "queue_full", "lane": "evidence", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}, "then": "retired"}
      ]
    },
    {
      "name": "a queue_full from an unconfigured device or an unauthenticated admission is no handoff",
      "steps": [
        {"event": "deliver", "response": {"status": 422, "reason": "unknown_key"}, "expect": "retained"},
        {"event": "queue_full_unconfigured_device", "expect": "no_attempt"},
        {"event": "admission_unauthenticated", "expect": "no_attempt"},
        {"event": "restart", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}, "then": "retired"}
      ]
    },
    {
      "name": "a queue_full handoff never brings a back-off or a Retry-After forward",
      "steps": [
        {"event": "deliver", "device": "device-a", "response": {"status": 503, "reason": "unavailable"}, "expect": "retained"},
        {"event": "queue_full", "device": "device-a", "expect": "no_attempt_before_backoff"},
        {"event": "deliver", "device": "device-b", "response": {"status": 429, "reason": "rate_limited", "retry_after_s": 60}, "expect": "retained"},
        {"event": "queue_full", "device": "device-b", "expect": "no_attempt_before_retry_after"},
        {"event": "backoff_elapsed", "device": "device-a", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 200}, "then": "retired"}
      ]
    },
    {
      "name": "a 503 retention_capacity_unavailable backs off without custody until capacity is restored, never by eviction",
      "steps": [
        {"event": "deliver", "response": {"status": 503, "reason": "retention_capacity_unavailable"}, "expect": "retained"},
        {"event": "handoff", "expect": "no_attempt_before_backoff"},
        {"event": "backoff_elapsed", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 503, "reason": "retention_capacity_unavailable"}, "then": "retained"},
        {"event": "backoff_elapsed", "expect": "attempt_fresh_envelope_same_bytes", "response": {"status": 409, "reason": "conflict", "outcome": "refused_retained"}, "then": "archived"}
      ]
    }
  ]
}
