gateway:
  broker_url: "tcp://localhost:1883"
  device_ids:
    - "ori-edge-site-a-01"
  heartbeat_interval_s: 30
  auth:
    enabled: false
    shared_secret_env: "GATEWAY_SHARED_SECRET"
    previous_shared_secret_env: "" # optional verify-only previous secret during rotation
  custody:
    # A SEPARATE secret from auth.shared_secret_env above, for a different
    # purpose: this one authenticates the gateway's claim that it is carrying
    # evidence. Reusing the envelope secret would let anything holding it for
    # one purpose mint artifacts for the other, and that is refused on the
    # resolved bytes rather than on the variable names.
    #
    # No key_id here: it is derived from the secret, so it changes when the
    # secret changes rather than when someone remembers to change it.
    #
    # Generate it from a CSPRNG with at least 256 bits of entropy, and provision
    # it with no surrounding whitespace -- the key is the secret's exact UTF-8
    # bytes, so a stray newline derives an identifier the runtime does not hold.
    # For example: openssl rand -base64 32
    #
    # A passphrase is not acceptable here. The custody MAC is what stands
    # between the runtime's queue and anything on the site network that can
    # reach the broker, and entropy is the only property that guarantee rests
    # on. Nothing at startup can measure it, so this requirement is yours to
    # keep: an unguessable secret is assumed by every check downstream of it.
    secret_env: "" # env var name only; never put the secret in gateway.yaml
  encryption:
    enabled: false # decrypt sensitive runtime export responses; requires auth.enabled

evidence:
  enabled: false
  # Separate durable directories. Never point either at fleet/report storage.
  queue_directory: "/var/lib/ori-gateway/evidence-outbound"
  return_queue_directory: "/var/lib/ori-gateway/evidence-return"
  max_items: 10000
  max_bytes: 268435456
  retry_interval_s: 5
  # Names only. The endpoint and credential values are provisioned outside this
  # operator-readable file and must be distinct from fleet, MQTT, and custody.
  endpoint_env: "ORI_EVIDENCE_ENDPOINT"
  client_id_env: "ORI_EVIDENCE_CLIENT_ID"
  secret_env: "ORI_EVIDENCE_INGEST_SECRET"

provider:
  name: "echo" # echo | llama_cpp | cloud_llm
  timeout_ms: 10000
  llama_cpp:
    url: "http://localhost:8080/completion"
    model: "llama-3.2-3b-instruct.gguf" # fallback if /props is unavailable
  cloud_llm:
    vendor: "gemini" # claude | gemini | openai | deepseek | openai_compatible
    api_key_env: "GEMINI_API_KEY"
    model: "gemini-2.5-flash"
    base_url: "" # optional override; blank uses the vendor default endpoint

reporting:
  provider: "gemini"
  gemini:
    api_key_env: "GEMINI_API_KEY"
    model: "gemini-2.5-flash"
    base_url: "" # optional override; blank uses the Gemini default endpoint
  weekly_report:
    enabled: false
    day: monday
    time: "08:00"
    timezone: Africa/Lagos
    device_id: "ori-runtime-dev-01"
    sensor_ids: ["current-main"]
    customer_name: ""
    site_name: ""
    delivery:
      file:
        enabled: false
        path: ""  # absolute path to write weekly-{slug}-{date}.json files
      cloud:
        enabled: false
        endpoint: ""  # https URL of the ori-cloud report ingest endpoint
        auth_env: ""  # env var name holding the ori-cloud API key (e.g. ORI_CLOUD_API_KEY)
  tier_c_enrichment:
    enabled: false # advisory only; with gateway.auth.enabled the requests are verified and responses signed


webhook_bridge:
  # Optional ingress bridge for providers that cannot sign webhook bodies.
  # Production topology: provider -> gateway bridge -> runtime localhost webhook.
  enabled: false
  listen_addr: "127.0.0.1:8090"
  path: "/webhooks/sms/africastalking"
  target_url: "http://127.0.0.1:8080/webhooks/sms/africastalking"
  provider_source_cidrs: [] # required for non-loopback listen_addr; never use 0.0.0.0/0
  runtime_token_env: "ORI_SMS_WEBHOOK_TOKEN"
  hmac_secret_env: "ORI_SMS_WEBHOOK_HMAC_SECRET"
  request_timeout_ms: 3000
  max_body_bytes: 65536

sim:
  enabled: false
  modem_path: "/dev/ttyUSB0"

fleet:
  enabled: false
  cloud_url: ""

site_health:
  enabled: false
  listen_addr: "127.0.0.1:8765"
